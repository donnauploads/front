# Base URL of the NestJS API. Drop the /api/v1 suffix if setGlobalPrefix is off.
NEXT_PUBLIC_API_BASE=

# Socket.io base URL (no path suffix — the gateway handles its own namespace).
NEXT_PUBLIC_WS_BASE=

# `true` to use in-memory mocks under lib/<domain>/mocks/, `false` to hit
# NEXT_PUBLIC_API_BASE. Defaults to `true` if unset for safety in CI.
NEXT_PUBLIC_USE_MOCKS=
