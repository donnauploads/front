# Base URL of the NestJS API. Drop the /api/v1 suffix if setGlobalPrefix is off.
NEXT_PUBLIC_API_BASE=

# Socket.io base URL (no path suffix — the gateway handles its own namespace).
NEXT_PUBLIC_WS_BASE=

# `true` to use in-memory mocks under lib/<domain>/mocks/, `false` to hit
# NEXT_PUBLIC_API_BASE. Defaults to `true` if unset for safety in CI.
NEXT_PUBLIC_USE_MOCKS=

# App/bank display name shown across the whole UI (single source of truth is
# lib/brand.ts). Leave blank to use the built-in default ("State Bank").
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time — change it, then rebuild/redeploy.
NEXT_PUBLIC_APP_NAME=
# Optional short form for tight spots (nav/logo lockup). Defaults to APP_NAME.
NEXT_PUBLIC_APP_SHORT=
